 "captions": [
  {
   "from": 0.05,
   "to": 1.461,
   "text": "Hi. I died 3 times today,",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 1.461,
   "to": 3.86,
   "text": "and I'd like to speak to a manager.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 3.86,
   "to": 5.27,
   "text": "I am the manager.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 5.27,
   "to": 7.6,
   "text": "Then I'd like to speak to your manager.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 8.1,
   "to": 10.65,
   "text": "He's... busy.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 10.65,
   "to": 13.18,
   "text": "The first time, I slipped on a fry.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 13.28,
   "to": 15.81,
   "text": "Slipped... on... fry.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 15.81,
   "to": 18.17,
   "text": "The second time, the same fry.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 18.22,
   "to": 19.92,
   "text": "You didn't pick it up?",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 19.92,
   "to": 21.77,
   "text": "I was dead!",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 21.82,
   "to": 23.48,
   "text": "And the third?",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 23.58,
   "to": 25.77,
   "text": "I went back for the fry.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 27.02,
   "to": 30.1,
   "text": "Okay. I can offer you Premium Afterlife.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 30.1,
   "to": 33.58,
   "text": "$9.99 a month. No fries.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 33.58,
   "to": 35.39,
   "text": "Is there a free version?",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 35.49,
   "to": 36.64,
   "text": "Yes.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 37.98,
   "to": 42.3,
   "text": "Your waiting time is 400 years. Please hold.",
   "pos": 470,
   "pop": false,
   "size": 64
  },
  {
   "from": 45.367,
   "to": 46.567,
   "text": "NEXT.",
   "pos": 470,
   "pop": false,
   "size": 64
  }
